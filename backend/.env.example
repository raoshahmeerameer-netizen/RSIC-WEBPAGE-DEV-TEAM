# Copy this file to .env and fill it in. .env is gitignored, never commit it.

# From Supabase: Project Settings -> API
SUPABASE_URL=https://rxottlnxbdfeihdjlufc.supabase.co

# MUST be the service_role key, not anon.
# Row Level Security is on, so the anon key cannot read or write these tables.
# This key is secret: it only ever lives on the server, never in the browser.
SUPABASE_KEY=paste-the-service-role-key-here

# The admin dashboard password. Pick a long one. Change it from the old value.
ADMIN_PASSWORD=change-this-to-something-long

# Where the site is served from. Comma separated. Leave unset to allow anything (dev only).
# ALLOWED_ORIGINS=https://your-site.netlify.app

PORT=5000

# Confirmation emails, sent when a delegation is approved from the dashboard.
# Leave these unset and approving still works, it just sends nothing.
#
# MAIL_USER is the Gmail address the mail comes from. MAIL_APP_PASSWORD is a
# Google App Password for that account, NOT the account's own password:
# the account needs 2-Step Verification on, then create one at
# https://myaccount.google.com/apppasswords. Google shows it as four groups of
# four; pasting the spaces is fine, they get stripped.
MAIL_USER=raviscienceandinnovation@gmail.com
MAIL_APP_PASSWORD=paste-the-16-character-app-password-here
MAIL_FROM_NAME=R.S.I.C

# Only if the host blocks outbound port 465: set this to 587 and it uses
# STARTTLS instead. Leave it unset otherwise.
# MAIL_PORT=587

# Any SMTP provider works, not only Gmail. For a mailbox on the site's own
# domain, or a sending service, set these instead of the Gmail ones above:
#
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=587
#   MAIL_USER=rsic@cityrsic.com
#   MAIL_APP_PASSWORD=that-mailbox-password
#   MAIL_FROM=rsic@cityrsic.com
#   MAIL_REPLY_TO=raviscienceandinnovation@gmail.com
#
# MAIL_USER is the SMTP login, MAIL_FROM is the address people see (it falls
# back to MAIL_USER), and MAIL_REPLY_TO is where replies should land.
